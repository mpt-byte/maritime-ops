# ──────────────────────────────────────────────────────────────────────────────
# Maritime Ops - Environment configuration
# Copy this file to .env and adjust the values.
# All API keys below are FREE / community-tier and never require payment.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL / PostGIS / TimescaleDB ──
POSTGRES_USER=maritime
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=maritime
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://maritime:change-me-in-production@postgres:5432/maritime

# ── Redis (real-time cache + pub/sub) ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ── Backend / API ──
BACKEND_HOST=0.0.0.0
BACKEND_PORT=4000
BACKEND_LOG_LEVEL=info
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ── JWT auth (admin / viewer) ──
JWT_SECRET=replace-with-a-long-random-string
JWT_AUDIENCE=maritime-ops
JWT_ISSUER=maritime-ops
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

# ── AIS data sources ──
# AISstream.io - free API key from https://aishub.net/aisstream.io
AISSTREAM_API_KEY=
# Bounding boxes (xmin,ymin,xmax,ymax) to subscribe to, semicolon separated.
# Default: world
AISSTREAM_BBOXES=-180,-90,180,90
AISSTREAM_ENABLED=true

# AISHub - http REST (requires contributing an NMEA feed). Optional.
AISHUB_API_KEY=
AISHUB_ENABLED=false
AISHUB_POLL_INTERVAL_MS=60000

# Local NMEA receiver (UDP or TCP). Optional.
NMEA_ENABLED=false
NMEA_UDP_PORT=10110
NMEA_TCP_HOST=
NMEA_TCP_PORT=

# ── Weather data sources ──
# Open-Meteo is keyless up to 10000 req/day. Optional key for higher limits.
OPEN_METEO_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_CACHE_TTL_MS=3600000

# OpenWeatherMap (optional freemium)
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org

# ── PWA / Web Push ──
# Generate VAPID keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
PUBLIC_BASE_URL=http://localhost:3000

# ── Frontend / Vite ──
VITE_API_BASE=http://localhost:4000/api/v1
VITE_WS_BASE=ws://localhost:4000/ws
VITE_VAPID_PUBLIC_KEY=${VAPID_PUBLIC_KEY}
# Leave empty to use the built-in nautical chart style (CARTO base +
# OpenSeaMap seamarks). Set to a MapLibre style.json URL to override.
VITE_MAP_TILE_URL=
