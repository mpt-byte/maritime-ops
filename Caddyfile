# Caddy reverse proxy for the full-stack Maritime Ops demo.
# One Caddy serves: TLS termination + routing to the frontend (static PWA),
# backend REST API, and backend WebSocket.
#
# Usage:
#   1) Set PUBLIC_DOMAIN (env) to your host, e.g. maritime.yourdomain.tld.
#      With PUBLIC_DOMAIN=localhost Caddy serves plain HTTP on :80 (no TLS).
#   2) Run: docker compose -f docker-compose.prod.yml up --build -d
#   3) On a real domain Caddy obtains Let's Encrypt TLS automatically.
#
# The frontend is built with VITE_API_BASE=/api/v1 and VITE_WS_BASE=/ws so
# same-origin requests hit Caddy, which proxies API + WS to the backend.
# You can still override the API base at runtime in the UI Toolbar.

{
	email {$CADDY_EMAIL:admin@example.com}
}

{$PUBLIC_DOMAIN:localhost} {
	encode zstd gzip

	# REST API -> backend.
	@apis path /api/v1/*
	reverse_proxy @apis backend:4000

	# WebSocket (positions stream). No compression on WS upgrade.
	@ws path /ws/*
	reverse_proxy @ws backend:4000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}

	# Everything else -> frontend nginx (static PWA + SPA fallback).
	reverse_proxy frontend:80

	# Cache-bust the service worker / manifest so PWA updates land.
	header /sw.js Cache-Control "no-cache"
	header /registerSW.js Cache-Control "no-cache"
	header /manifest.webmanifest Cache-Control "no-cache"

	# Sensible security headers.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=()"
	}
}
